# Development defaults, committed.
#
# Symfony loads this file only when .env does not exist. .env is untracked and production only:
# a production host writes its own .env (or sets real environment variables), and this file is
# then ignored. In dev and test there is no .env, so these values apply.
#
# On top of this file, when they exist (latter wins):
#  * .env.local          uncommitted local overrides (not loaded in test)
#  * .env.$APP_ENV       committed environment-specific values (.env.test)
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables (compose.yaml) win over every file.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev-only-not-a-secret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/mongodb-odm-bundle ###
# Format described at https://www.mongodb.com/docs/php-library/current/connect/connection-options/
# MONGODB_URI="mongodb://username:password@localhost:27017/?authSource=auth-db"
# MONGODB_URI="mongodb+srv://username:password@YOUR_CLUSTER_NAME.YOUR_HASH.mongodb.net/?retryWrites=true&w=majority"
MONGODB_URI=mongodb://app:app@mongodb:27017
MONGODB_DB=app
###< doctrine/mongodb-odm-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
MESSENGER_FAILURE_TRANSPORT_DSN=redis://redis:6379/failed
###< symfony/messenger ###

###> app ###
# Simulated response time of the mocked LLM, so the "Analysing…" state can be seen.
MOCK_LLM_LATENCY_MS=1500
###< app ###
