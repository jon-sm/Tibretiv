{#
    Confirmation after a successful application. Variables: see CandidateApplicationSubmissionController.
    `confirmation` is null after a refresh or a direct visit: only the link back is shown.
    Design: templates/mockups/confirmation.html.twig.
#}
{% extends 'layouts/public.html.twig' %}

{% block page_title %}Application received{% endblock %}

{% block content %}
    <section class="mx-auto max-w-xl rounded-xl border border-line bg-surface p-8 text-center shadow-sm sm:p-10">
        {% if confirmation %}
            <div class="mx-auto mb-6 flex size-14 items-center justify-center rounded-full bg-success-soft text-success">
                <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
            </div>
            <h1 class="text-2xl font-semibold tracking-tight">Application received</h1>
            <p class="mt-4 leading-relaxed text-fg-muted">
                Thanks, {{ confirmation.name }}. We've received your application for
                <span class="font-medium text-fg">{{ confirmation.positionTitle }}</span>
                and will be in touch at <span class="font-medium text-fg">{{ confirmation.email }}</span>.
            </p>
        {% else %}
            <h1 class="text-2xl font-semibold tracking-tight">Nothing to show here</h1>
            <p class="mt-4 text-fg-muted">If you just applied, your application was received.</p>
        {% endif %}
        <a href="{{ path('positions_index') }}" class="mt-8 inline-flex items-center gap-1 font-medium no-underline">
            <span aria-hidden="true">←</span> See other positions
        </a>
    </section>
{% endblock %}
