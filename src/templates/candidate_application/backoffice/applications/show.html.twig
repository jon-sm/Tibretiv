{#
    Backoffice: application detail. Variables: see CandidateApplicationsController::show().
    Design: templates/mockups/application.html.twig.
#}
{% extends 'layouts/backoffice.html.twig' %}

{% set nav = 'applications' %}

{% block page_title %}{{ application.fullName }}{% endblock %}

{% macro copy_button(value, label) %}
    <button type="button" class="relative inline-flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-md text-fg-subtle hover:bg-surface-muted hover:text-fg"
            x-data="{ copied: false }"
            @click="navigator.clipboard?.writeText({{ value|json_encode|e('html_attr') }}); copied = true; setTimeout(() => copied = false, 1500)"
            aria-label="Copy {{ label }}" title="Copy {{ label }}">
        <svg x-show="!copied" class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M7 3.5A1.5 1.5 0 0 1 8.5 2h3.88a1.5 1.5 0 0 1 1.06.44l3.12 3.12A1.5 1.5 0 0 1 17 6.62V12.5a1.5 1.5 0 0 1-1.5 1.5h-1v-3.38a3 3 0 0 0-.88-2.12L10.5 5.38a3 3 0 0 0-2.12-.88H7v-1Z"/><path d="M4.5 6A1.5 1.5 0 0 0 3 7.5v9A1.5 1.5 0 0 0 4.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.88a1.5 1.5 0 0 0-.44-1.06L9.44 6.44A1.5 1.5 0 0 0 8.38 6H4.5Z"/></svg>
        <svg x-show="copied" x-cloak class="size-4 text-success" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.58l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
        <span x-show="copied" x-cloak class="absolute -top-8 left-1/2 -translate-x-1/2 rounded bg-fg px-2 py-1 text-xs whitespace-nowrap text-white">Copied</span>
    </button>
{% endmacro %}

{% macro datetime(value) -%}
    {{- value ? value|date('j M Y, H:i', 'Europe/Madrid') : '—' -}}
{%- endmacro %}

{% set check_icon %}<svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.58l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>{% endset %}

{% block content %}
    <a href="{{ path('backoffice_applications', back) }}" class="inline-flex items-center gap-1 text-sm font-medium no-underline">
        <span aria-hidden="true">←</span> Applications
    </a>

    {# Header: name, position, status control #}
    <header class="mt-6 mb-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="min-w-0">
            <h1 class="text-3xl font-semibold tracking-tight">{{ application.fullName }}</h1>
            {% if application.position %}
                <p class="mt-2 text-fg-muted">
                    <span class="font-medium text-fg">{{ application.position.title }}</span>
                    · <twig:JobPositionMeta :position="application.position" />
                </p>
            {% endif %}
        </div>

        {# Saves as soon as a value is picked; the Save button is the no-JavaScript fallback #}
        <div class="relative w-full sm:w-52" x-data="statusForm">
            {{ form_start(statusForm, {attr: {'x-ref': 'form', '@change': 'save()', class: 'grid gap-2'}}) }}
                {{ form_row(statusForm.status) }}
                <twig:Button size="sm" type="submit" x-show="false">Save</twig:Button>
            {{ form_end(statusForm) }}

            <div class="absolute top-full right-0 mt-2 text-sm font-medium whitespace-nowrap">
                {# After a normal submit #}
                {% for message in app.flashes('success') %}
                    <p role="status" class="inline-flex items-center gap-1 text-success" x-data="{ shown: true }" x-show="shown && state === 'idle'" x-init="setTimeout(() => shown = false, 2000)" x-transition.opacity>
                        {{ check_icon }} {{ message }}
                    </p>
                {% endfor %}
                {# After saving with JavaScript #}
                <p role="status" class="inline-flex items-center gap-1 text-success" x-show="state === 'saved'" x-cloak x-transition.opacity>{{ check_icon }} Status updated</p>
                <p role="alert" class="text-danger" x-show="state === 'error'" x-cloak>Could not save the status. Try again.</p>
            </div>
        </div>
    </header>

    <div class="grid gap-6">
        {# AI enrichment #}
        <section id="enrichment" aria-labelledby="enrichment-title" class="rounded-xl border border-line bg-surface p-6 shadow-xs"
                 {% if application.isEnrichmentPending %}x-data="enrichmentPoller('{{ path('backoffice_enrichment_states') }}', '{{ application.id }}')"{% endif %}>
            <div class="mb-4 flex items-center gap-2">
                <svg class="size-5 text-accent" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5a.75.75 0 0 1 .7.48l1.37 3.6a2 2 0 0 0 1.16 1.16l3.6 1.37a.75.75 0 0 1 0 1.4l-3.6 1.37a2 2 0 0 0-1.16 1.16l-1.37 3.6a.75.75 0 0 1-1.4 0l-1.37-3.6a2 2 0 0 0-1.16-1.16l-3.6-1.37a.75.75 0 0 1 0-1.4l3.6-1.37a2 2 0 0 0 1.16-1.16l1.37-3.6A.75.75 0 0 1 10 1.5Z"/></svg>
                <h2 id="enrichment-title" class="text-lg font-semibold">AI enrichment</h2>
            </div>

            {% if application.enrichmentStatus == 'completed' %}
                <div class="grid gap-6 sm:grid-cols-[10rem_minmax(0,1fr)]">
                    <div>
                        <p class="text-sm font-medium text-fg-muted">Score</p>
                        <p class="mt-2 flex items-baseline gap-2">
                            <span class="text-4xl font-semibold tracking-tight tabular-nums">{{ application.score }}</span>
                            <span class="text-sm text-fg-subtle">/ 100</span>
                        </p>
                        <twig:ScoreBadge score="{{ application.score }}" show="band" class="mt-2" />
                    </div>
                    <div>
                        <p class="text-sm font-medium text-fg-muted">Summary</p>
                        <p class="mt-2 max-w-3xl leading-relaxed">{{ application.summary }}</p>
                        {% if application.enrichedAt %}
                            <p class="mt-4 text-sm text-fg-subtle">
                                Enriched <time datetime="{{ application.enrichedAt|date('c') }}" title="{{ _self.datetime(application.enrichedAt) }} (Europe/Madrid)">{{ application.enrichedAt|time_ago }}</time>
                            </p>
                        {% endif %}
                    </div>
                </div>
            {% elseif application.enrichmentStatus == 'pending' %}
                <div class="flex items-center gap-3 rounded-lg bg-surface-muted p-4">
                    <svg class="size-5 shrink-0 animate-spin text-accent" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity="0.25" stroke-width="3"/>
                        <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                    </svg>
                    <div>
                        <p class="font-medium">Analysing the CV…</p>
                        <p class="text-sm text-fg-muted">The score and summary appear here automatically.</p>
                    </div>
                </div>
            {% else %}
                <twig:Alert tone="danger" title="Enrichment failed">The CV could not be analysed.</twig:Alert>
            {% endif %}
        </section>

        <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
            {# Candidate #}
            <section id="candidate" aria-labelledby="candidate-title" class="rounded-xl border border-line bg-surface p-6 shadow-xs">
                <h2 id="candidate-title" class="mb-4 text-lg font-semibold">Candidate</h2>
                <dl class="divide-y divide-line text-sm">
                    {% for row in [
                        {label: 'Name', value: application.name},
                        {label: 'Surname', value: application.surname},
                        {label: 'Email', value: application.email, copy: true, href: 'mailto:' ~ application.email},
                        {label: 'Phone', value: application.phone, copy: true, href: 'tel:' ~ application.phone|replace({' ': ''})},
                        {label: 'Notes', value: application.notes ?: '—'},
                    ] %}
                        <div class="grid gap-1 py-2.5 sm:grid-cols-[7rem_minmax(0,1fr)] sm:items-center sm:gap-4">
                            <dt class="text-fg-muted">{{ row.label }}</dt>
                            <dd class="flex min-h-7 min-w-0 items-center gap-2">
                                {% if row.href is defined %}
                                    <a href="{{ row.href }}" class="truncate">{{ row.value }}</a>
                                {% else %}
                                    <span class="whitespace-pre-line text-fg">{{ row.value }}</span>
                                {% endif %}
                                {% if row.copy is defined %}{{ _self.copy_button(row.value, row.label|lower) }}{% endif %}
                            </dd>
                        </div>
                    {% endfor %}
                </dl>
            </section>

            {# Timeline #}
            <section id="timeline" aria-labelledby="timeline-title" class="rounded-xl border border-line bg-surface p-6 shadow-xs">
                <h2 id="timeline-title" class="mb-4 text-lg font-semibold">Timeline</h2>
                <dl class="grid gap-3 text-sm">
                    {% for row in [
                        {label: 'Applied', value: _self.datetime(application.appliedAt)},
                        {label: 'Enriched', value: application.enrichedAt ? _self.datetime(application.enrichedAt) : (application.isEnrichmentPending ? 'Pending' : 'Failed')},
                        {label: 'Updated', value: _self.datetime(application.updatedAt)},
                    ] %}
                        <div class="flex justify-between gap-4">
                            <dt class="text-fg-muted">{{ row.label }}</dt>
                            <dd class="text-right tabular-nums">{{ row.value }}</dd>
                        </div>
                    {% endfor %}
                </dl>
                <p class="mt-4 text-xs text-fg-subtle">Times in Europe/Madrid.</p>
            </section>
        </div>

        {# CV #}
        <section id="cv" aria-labelledby="cv-title" class="rounded-xl border border-line bg-surface p-6 shadow-xs">
            <h2 id="cv-title" class="mb-4 text-lg font-semibold">CV</h2>
            <pre class="overflow-x-auto rounded-lg bg-surface-muted p-4 font-mono text-[0.8125rem] leading-relaxed whitespace-pre-wrap text-fg">{{ application.cv }}</pre>
        </section>
    </div>
{% endblock %}
