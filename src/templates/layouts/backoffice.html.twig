{#
    Recruiter layout: app bar with navigation, then the page.
    Set `nav` to the active section ("applications") and the `*_href` links before extending.
#}
{% extends 'base.html.twig' %}

{% block title %}{% block page_title %}Backoffice{% endblock %} · tibretiv backoffice{% endblock %}

{% set nav_items = [
    {id: 'applications', label: 'Applications', href: applications_href|default(path('backoffice_applications'))},
] %}

{% block body %}
<div class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-10 border-b border-line bg-surface/90 backdrop-blur">
        <div class="mx-auto flex h-14 max-w-7xl items-center gap-6 px-4 sm:px-6">
            <div class="flex items-center gap-2">
                <twig:Logo href="{{ applications_href|default(path('backoffice_applications')) }}" />
                <twig:Badge tone="accent">backoffice</twig:Badge>
            </div>
            <nav aria-label="Main" class="flex h-full items-stretch gap-1">
                {% for item in nav_items %}
                    {% set active = item.id == nav|default('') %}
                    <a href="{{ item.href }}"
                       {% if active %}aria-current="page"{% endif %}
                       class="flex items-center border-b-2 px-3 text-sm font-medium no-underline {{ active ? 'border-accent text-fg hover:text-fg' : 'border-transparent text-fg-muted hover:border-line-strong hover:text-fg' }}">
                        {{ item.label }}
                    </a>
                {% endfor %}
            </nav>
        </div>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6">
        {% block content %}{% endblock %}
    </main>
</div>
{% endblock %}
