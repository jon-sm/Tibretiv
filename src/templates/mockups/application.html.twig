{% extends 'mockups/_backoffice.html.twig' %}

{% set nav = 'applications' %}

{% block page_title %}Jane Doe{% endblock %}

{# Fake data: replaced by the "get application" query when wired. state = enrichment status. #}
{% set application = {
    candidate: {name: 'Jane', surname: 'Doe', email: 'jane.doe@gmail.com', phone: '+34 600 000 000'},
    notes: 'Available from January. Happy to do the technical interview in English or Spanish.',
    position: {title: 'Senior Backend Engineer', workMode: 'Hybrid', location: 'Madrid'},
    status: 'received',
    enrichment: {
        status: state,
        score: 87,
        summary: 'Backend engineer with 8 years of experience, mostly PHP (Symfony) and Go. Strong on event-driven systems: led a migration to asynchronous services with RabbitMQ and owned the retry and failure handling. Hands-on MongoDB and PostgreSQL. Led a team of four. Matches most of the requirements; no Kubernetes experience listed.',
        enrichedAt: state == 'completed' ? '4 Nov 2026, 11:15' : null,
        enrichedAgo: '1 h ago',
    },
    appliedAt: '4 Nov 2026, 11:15',
    updatedAt: '4 Nov 2026, 12:40',
    cv: "JANE DOE
Backend engineer · Madrid, Spain
jane.doe@gmail.com · +34 600 000 000

EXPERIENCE

2021 – now   Senior Backend Engineer, Acme Logistics
             - Led the move from a monolith to event-driven services
               (Symfony Messenger, RabbitMQ), cutting order processing
               time from minutes to seconds.
             - Designed retry and dead-letter handling for 40+ consumers.
             - Mentored four engineers; ran the backend guild.

2018 – 2021  Backend Engineer, Shiply
             - Built the tracking API in Go, 2k requests per second.
             - Moved reporting from PostgreSQL to MongoDB aggregations.

2016 – 2018  Web Developer, Freelance
             - PHP and Laravel projects for small businesses.

SKILLS

PHP 8, Symfony, Go, MongoDB, PostgreSQL, RabbitMQ, Redis, Docker,
PHPUnit, DDD, hexagonal architecture, CQRS

EDUCATION

2012 – 2016  BSc Computer Engineering, Universidad Politécnica de Madrid

LANGUAGES

Spanish (native), English (C1)",
} %}

{% macro copy_button(value, label) %}
    <button type="button" class="relative inline-flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-md text-fg-subtle hover:bg-surface-muted hover:text-fg"
            x-data="{ copied: false }"
            @click="navigator.clipboard?.writeText({{ value|json_encode|e('html_attr') }}); copied = true; setTimeout(() => copied = false, 1500)"
            aria-label="Copy {{ label }}" title="Copy {{ label }}">
        <svg x-show="!copied" class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M7 3.5A1.5 1.5 0 0 1 8.5 2h3.88a1.5 1.5 0 0 1 1.06.44l3.12 3.12A1.5 1.5 0 0 1 17 6.62V12.5a1.5 1.5 0 0 1-1.5 1.5h-1v-3.38a3 3 0 0 0-.88-2.12L10.5 5.38a3 3 0 0 0-2.12-.88H7v-1Z"/><path d="M4.5 6A1.5 1.5 0 0 0 3 7.5v9A1.5 1.5 0 0 0 4.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.88a1.5 1.5 0 0 0-.44-1.06L9.44 6.44A1.5 1.5 0 0 0 8.38 6H4.5Z"/></svg>
        <svg x-show="copied" x-cloak class="size-4 text-success" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.58l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
        <span x-show="copied" x-cloak class="absolute -top-8 left-1/2 -translate-x-1/2 rounded bg-fg px-2 py-1 text-xs whitespace-nowrap text-white">Copied</span>
    </button>
{% endmacro %}

{% block content %}
    <a href="{{ path('mockup', {page: 'applications'}) }}" class="inline-flex items-center gap-1 text-sm font-medium no-underline">
        <span aria-hidden="true">←</span> Applications
    </a>

    {# Header: name, position, status control #}
    <header class="mt-6 mb-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="min-w-0">
            <h1 class="text-3xl font-semibold tracking-tight">{{ application.candidate.name }} {{ application.candidate.surname }}</h1>
            <p class="mt-2 text-fg-muted">
                <span class="font-medium text-fg">{{ application.position.title }}</span>
                · {{ application.position.workMode }} · {{ application.position.location }}
            </p>
        </div>
        <div class="relative w-full sm:w-52" x-data="{ saved: false, timer: null }">
            <twig:Field label="Status" for="status">
                <twig:Select id="status" @change="saved = true; clearTimeout(timer); timer = setTimeout(() => saved = false, 2000)">
                    {% for value, label in {received: 'Received', contacted: 'Contacted', rejected: 'Rejected', hired: 'Hired'} %}
                        <option value="{{ value }}" {{ value == application.status ? 'selected' }}>{{ label }}</option>
                    {% endfor %}
                </twig:Select>
            </twig:Field>
            <p x-show="saved" x-cloak x-transition.opacity role="status"
               class="absolute top-full right-0 mt-2 inline-flex items-center gap-1 text-sm font-medium text-success">
                <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.58l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
                Status updated
            </p>
        </div>
    </header>

    <div class="grid gap-6">
        {# AI enrichment #}
        <section aria-labelledby="ai" class="rounded-xl border border-line bg-surface p-6 shadow-xs">
            <div class="mb-4 flex items-center gap-2">
                <svg class="size-5 text-accent" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5a.75.75 0 0 1 .7.48l1.37 3.6a2 2 0 0 0 1.16 1.16l3.6 1.37a.75.75 0 0 1 0 1.4l-3.6 1.37a2 2 0 0 0-1.16 1.16l-1.37 3.6a.75.75 0 0 1-1.4 0l-1.37-3.6a2 2 0 0 0-1.16-1.16l-3.6-1.37a.75.75 0 0 1 0-1.4l3.6-1.37a2 2 0 0 0 1.16-1.16l1.37-3.6A.75.75 0 0 1 10 1.5Z"/></svg>
                <h2 id="ai" class="text-lg font-semibold">AI enrichment</h2>
            </div>

            {% if application.enrichment.status == 'completed' %}
                <div class="grid gap-6 sm:grid-cols-[10rem_minmax(0,1fr)]">
                    <div>
                        <p class="text-sm font-medium text-fg-muted">Score</p>
                        <p class="mt-2 flex items-baseline gap-2">
                            <span class="text-4xl font-semibold tracking-tight tabular-nums">{{ application.enrichment.score }}</span>
                            <span class="text-sm text-fg-subtle">/ 100</span>
                        </p>
                        <twig:ScoreBadge score="{{ application.enrichment.score }}" show="band" class="mt-2" />
                    </div>
                    <div>
                        <p class="text-sm font-medium text-fg-muted">Summary</p>
                        <p class="mt-2 max-w-3xl leading-relaxed">{{ application.enrichment.summary }}</p>
                        <p class="mt-4 text-sm text-fg-subtle">
                            Enriched <time title="{{ application.enrichment.enrichedAt }} (Europe/Madrid)">{{ application.enrichment.enrichedAgo }}</time>
                        </p>
                    </div>
                </div>
            {% elseif application.enrichment.status == 'pending' %}
                <div class="flex items-center gap-3 rounded-lg bg-surface-muted p-4">
                    <svg class="size-5 shrink-0 animate-spin text-accent" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity="0.25" stroke-width="3"/>
                        <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                    </svg>
                    <div>
                        <p class="font-medium">Analysing the CV…</p>
                        <p class="text-sm text-fg-muted">The score and summary appear here automatically.</p>
                    </div>
                </div>
            {% else %}
                <twig:Alert tone="danger" title="Enrichment failed">The CV could not be analysed.</twig:Alert>
            {% endif %}
        </section>

        <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
            {# Candidate #}
            <section aria-labelledby="candidate" class="rounded-xl border border-line bg-surface p-6 shadow-xs">
                <h2 id="candidate" class="mb-4 text-lg font-semibold">Candidate</h2>
                <dl class="divide-y divide-line text-sm">
                    {% for row in [
                        {label: 'Name', value: application.candidate.name},
                        {label: 'Surname', value: application.candidate.surname},
                        {label: 'Email', value: application.candidate.email, copy: true, href: 'mailto:' ~ application.candidate.email},
                        {label: 'Phone', value: application.candidate.phone, copy: true, href: 'tel:' ~ application.candidate.phone|replace({' ': ''})},
                        {label: 'Notes', value: application.notes ?: '—'},
                    ] %}
                        <div class="grid gap-1 py-2.5 sm:grid-cols-[7rem_minmax(0,1fr)] sm:items-center sm:gap-4">
                            <dt class="text-fg-muted">{{ row.label }}</dt>
                            <dd class="flex min-h-7 min-w-0 items-center gap-2">
                                {% if row.href is defined %}
                                    <a href="{{ row.href }}" class="truncate">{{ row.value }}</a>
                                {% else %}
                                    <span class="text-fg">{{ row.value }}</span>
                                {% endif %}
                                {% if row.copy is defined %}{{ _self.copy_button(row.value, row.label|lower) }}{% endif %}
                            </dd>
                        </div>
                    {% endfor %}
                </dl>
            </section>

            {# Timeline #}
            <section aria-labelledby="timeline" class="rounded-xl border border-line bg-surface p-6 shadow-xs">
                <h2 id="timeline" class="mb-4 text-lg font-semibold">Timeline</h2>
                <dl class="grid gap-3 text-sm">
                    {% for row in [
                        {label: 'Applied', value: application.appliedAt},
                        {label: 'Enriched', value: application.enrichment.enrichedAt ?? (state == 'pending' ? 'Pending' : 'Failed')},
                        {label: 'Updated', value: application.updatedAt},
                    ] %}
                        <div class="flex justify-between gap-4">
                            <dt class="text-fg-muted">{{ row.label }}</dt>
                            <dd class="text-right tabular-nums">{{ row.value }}</dd>
                        </div>
                    {% endfor %}
                </dl>
                <p class="mt-4 text-xs text-fg-subtle">Times in Europe/Madrid.</p>
            </section>
        </div>

        {# CV #}
        <section aria-labelledby="cv" class="rounded-xl border border-line bg-surface p-6 shadow-xs">
            <h2 id="cv" class="mb-4 text-lg font-semibold">CV</h2>
            <pre class="overflow-x-auto rounded-lg bg-surface-muted p-4 font-mono text-[0.8125rem] leading-relaxed whitespace-pre-wrap text-fg">{{ application.cv }}</pre>
        </section>
    </div>
{% endblock %}
