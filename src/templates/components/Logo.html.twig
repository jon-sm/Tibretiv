{#
    tibretiv wordmark with its mark.

    <twig:Logo />  <twig:Logo href="/" />
#}
{% props href = null %}

{% set tag = href ? 'a' : 'span' %}
<{{ tag }} {% if href %}href="{{ href }}"{% endif %} {{ attributes.defaults({class: 'inline-flex items-center gap-2 text-fg no-underline hover:text-fg'}) }}>
    <svg class="size-7" viewBox="0 0 28 28" aria-hidden="true">
        <rect width="28" height="28" rx="7" class="fill-accent"/>
        <path d="M11 7.5v10.25a2.75 2.75 0 0 0 2.75 2.75H17" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M8 11.5h9" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="20" cy="20.5" r="1.75" fill="white"/>
    </svg>
    <span class="text-lg font-semibold tracking-tight">tibretiv</span>
</{{ tag }}>
