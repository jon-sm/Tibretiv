{#
    <twig:Alert tone="danger" title="Enrichment failed">The CV could not be analysed.</twig:Alert>

    tone: info | success | warning | danger
#}
{% props tone = 'info', title = null %}

{% set alert = html_cva(
    base: 'flex gap-3 rounded-lg p-4 text-sm ring-1 ring-inset',
    variants: {
        tone: {
            info: 'bg-info-soft text-info ring-info/20',
            success: 'bg-success-soft text-success ring-success/20',
            warning: 'bg-warning-soft text-warning ring-warning/25',
            danger: 'bg-danger-soft text-danger ring-danger/20',
        },
    },
) %}

<div role="{{ tone == 'danger' ? 'alert' : 'status' }}" {{ attributes.without('class') }} class="{{ alert.apply({tone: tone}, attributes.render('class')) }}">
    <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        {% if tone == 'success' %}
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.86-9.81a.75.75 0 0 0-1.22-.87l-3.24 4.53-1.62-1.62a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.1l3.75-5.25Z" clip-rule="evenodd"/>
        {% elseif tone == 'info' %}
            <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.25v2.75a.75.75 0 0 0 1.5 0V9.75A.75.75 0 0 0 10 9H9Z" clip-rule="evenodd"/>
        {% else %}
            <path fill-rule="evenodd" d="M8.49 2.87c.67-1.16 2.35-1.16 3.02 0l6.28 10.88c.67 1.16-.17 2.62-1.51 2.62H3.72c-1.34 0-2.18-1.46-1.51-2.62L8.49 2.87ZM10 6a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 6Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/>
        {% endif %}
    </svg>
    <div class="grid gap-1">
        {% if title %}<p class="font-semibold">{{ title }}</p>{% endif %}
        <div class="text-fg-muted">{% block content %}{% endblock %}</div>
    </div>
</div>
